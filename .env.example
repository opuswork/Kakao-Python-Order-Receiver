# Set these in Vercel Environment Variables. Local uvicorn does not load this file automatically.
# Never commit real values: this repository is public.
KAKAO_SKILL_SECRET=<random 32+ characters, same value as the Kakao skill header X-Kakao-Skill-Key>
DRY_RUN=true
SANC_API_BASE_URL=https://be-aosm.onrender.com
# Admin JWT (role admin). Used for catalog/member/partner lookups and, with DRY_RUN=false, POST /api/orders.
SANC_API_TOKEN=
# Alternative to the token: admin automation account for POST /api/auth/login.
SANC_LOGIN_ID=
SANC_LOGIN_PW=
# Receiver PostgreSQL (run schema.sql first). Required when DRY_RUN=false.
RECEIVER_DATABASE_URL=
